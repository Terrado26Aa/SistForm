<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Forms.Services"
             x:Class="Forms.Views.AssignFormPage"
             Title="Asignar Encuesta">
    
    <VerticalStackLayout Padding="20" Spacing="15"
                         BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
        <Label x:Name="FormTitleLabel" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" 
               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
        
        <Label Text="Selecciona un usuario para asignarle esta encuesta:" FontSize="14" 
               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"/>

        <CollectionView x:Name="UsersList" SelectionMode="Single" HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="10" BorderColor="{AppThemeBinding Light=LightGray, Dark=#555555}" CornerRadius="8"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <VerticalStackLayout>
                            <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <Label Text="{Binding FirstName, StringFormat='{0} '}" FontSize="14"
                                   TextColor="{AppThemeBinding Light=DarkGray, Dark=LightGray}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="FirstName" />
                                        <Binding Path="LastName" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Asignar Encuesta" Clicked="OnAssignClicked" 
                BackgroundColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50"/>
        
        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>
