<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.HomePage"
             Title="HomePage">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <VerticalStackLayout>
        <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*">
            <StackLayout Padding="10,10,0,20" Grid.ColumnSpan="2">
                <Label Text="Bienvenido Usuario" FontSize="20" FontAttributes="Bold" Margin="10,10,0,0"/>
            </StackLayout>
            <Frame Grid.Row="1" Grid.ColumnSpan="2" Padding="0" Margin="10" CornerRadius="10">
                <SearchBar/>
            </Frame>
            <Label Grid.Row="2" Text="Proyectos en Curso" FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Start" VerticalOptions="Center" Margin="10,10,0,10"/>
            <Label Grid.Row="2" Grid.Column="1" Text="Ver todo" HorizontalOptions="EndAndExpand"
                   VerticalOptions="Center" Margin="0,10,10,10"/>
            <Frame Grid.Row="3" CornerRadius="10" Padding="0,5,0,0" Margin="10">
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label Padding="10,5,0,0" Text="Dic. 12, 2024" FontSize="10"/>
                    <Image Grid.Column="1" Source="puntos2.png" WidthRequest="15" HeightRequest="15"
                           VerticalOptions="Start" HorizontalOptions="End"/>
                    <Label Padding="10,15,25,25" Grid.Row="1" Grid.ColumnSpan="2" Text="Aves en Peligro de Extinsion" FontSize="12"/>
                </Grid>
            </Frame>
            <Frame Grid.Row="3" Grid.Column="1" CornerRadius="10" Padding="0,5,0,0" Margin="10">
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label Padding="10,5,0,0" Text="Dic. 15, 2024" FontSize="10"/>
                    <Image Grid.Column="1" Source="puntos2.png" WidthRequest="15" HeightRequest="15"
                           VerticalOptions="Start" HorizontalOptions="End"/>
                    <Label Padding="10,15,25,25" Grid.Row="1" Grid.ColumnSpan="2" Text="Tipos de Plantas Medicinales" FontSize="12"/>
                </Grid>
            </Frame>
            <Frame Grid.Row="4" CornerRadius="10" Padding="0,5,0,0" Margin="10">
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label Padding="10,5,0,0" Text="Dic. 17, 2024" FontSize="10"/>
                    <Image Grid.Column="1" Source="puntos2.png" WidthRequest="15" HeightRequest="15"
               VerticalOptions="Start" HorizontalOptions="End"/>
                    <Label Padding="10,15,25,25" Grid.Row="1" Grid.ColumnSpan="2" Text="Reptiles" FontSize="12"/>
                </Grid>
            </Frame>
            <Frame Grid.Row="4" Grid.Column="1" CornerRadius="10" Padding="0,5,0,0" Margin="10">
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label Padding="10,5,0,0" Text="Dic. 19, 2024" FontSize="10"/>
                    <Image Grid.Column="1" Source="puntos2.png" WidthRequest="15" HeightRequest="15"
                           VerticalOptions="Start" HorizontalOptions="End"/>
                    <Label Padding="10,15,25,25" Grid.Row="1" Grid.ColumnSpan="2" Text="Mamiferos" FontSize="12"/>
                </Grid>
            </Frame>
        </Grid>
    </VerticalStackLayout>
</ContentPage>