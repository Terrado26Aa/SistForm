<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.HomePage"
             Title="Dashboard"
             Shell.NavBarIsVisible="True"
             Shell.FlyoutBehavior="Flyout"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="10">
            <Label x:Name="WelcomeLabel" Text="Bienvenido" FontSize="24" FontAttributes="Bold" Margin="0,10,0,5"
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
            
            <!-- Stats Cards -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" Margin="0,10,0,10">
                <Frame Grid.Column="0" CornerRadius="10" BackgroundColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Encuestas" FontSize="14" TextColor="White"/>
                        <Label x:Name="TotalFormsLabel" Text="0" FontSize="32" FontAttributes="Bold" TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" CornerRadius="10" BackgroundColor="{AppThemeBinding Light=Orange, Dark=DarkOrange}" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Usuarios" FontSize="14" TextColor="White"/>
                        <Label x:Name="TotalUsersLabel" Text="0" FontSize="32" FontAttributes="Bold" TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>
            
            <Frame CornerRadius="10" BackgroundColor="{AppThemeBinding Light=Green, Dark=ForestGreen}" Padding="15" Margin="0,0,0,10">
                <VerticalStackLayout>
                    <Label Text="Respuestas" FontSize="14" TextColor="White"/>
                    <Label x:Name="TotalResponsesLabel" Text="0" FontSize="32" FontAttributes="Bold" TextColor="White"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Recent Forms -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,5">
                <Label Text="Encuestas Recientes" FontSize="18" FontAttributes="Bold" 
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                <Button Grid.Column="1" Text="Ver todo" Clicked="OnViewAllClicked" 
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}"/>
            </Grid>

            <CollectionView x:Name="RecentFormsList" SelectionMode="None" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5,0,5" Padding="15" CornerRadius="10"
                               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                    <Label Text="{Binding Description}" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding CreationDate, StringFormat='{0:dd/MM/yyyy}'}" 
                                       FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Admin Actions -->
            <Button x:Name="CreateSurveyButton" Text="Crear Nueva Encuesta" 
                    Clicked="OnCreateClicked" 
                    BackgroundColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" 
                    TextColor="White" 
                    Margin="0,20,0,10"
                    CornerRadius="10"
                    IsVisible="False"/>
            
            <Button x:Name="ManageUsersButton" Text="Gestionar Usuarios" 
                    Clicked="OnManageUsersClicked" 
                    BackgroundColor="{AppThemeBinding Light=Orange, Dark=DarkOrange}" 
                    TextColor="White" 
                    Margin="0,10,0,10"
                    CornerRadius="10"
                    IsVisible="False"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>