<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.ManageFormsPage"
             Title="Administar Encuesta">
    <CollectionView x:Name="FormsList" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="15" BorderColor="Gray" CornerRadius="10">
                    
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="{Binding Description}" FontSize="14" TextColor="DarkGray"/>
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="1" Source="edit_icon.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent"
                                     Clicked="OnEditClicked" CommandParameter="{Binding .}"/>
                        <ImageButton Grid.Column="2" Source="delete_icon3.png" WidthRequest="25" HeightRequest="25" BackgroundColor="Transparent"
                                     Clicked="OnDeleteClicked" CommandParameter="{Binding .}"/>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>