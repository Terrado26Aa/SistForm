<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.ManageFormsPage"
             Title="Administrar Encuestas">
    <Grid>
        <!-- Lista principal de encuestas -->
        <CollectionView x:Name="FormsList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10" Padding="15" BorderColor="{AppThemeBinding Light=Gray, Dark=DarkGray}" 
                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}" CornerRadius="10">
                        
                        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="10">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Label Text="{Binding Description}" FontSize="14" 
                                       TextColor="{AppThemeBinding Light=DarkGray, Dark=LightGray}"/>
                            </VerticalStackLayout>
                            
                            <!-- Botón Asignar (solo Admin) -->
                            <ImageButton Grid.Column="1" Source="agregar.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent"
                                         Clicked="OnAssignClicked" CommandParameter="{Binding .}" ToolTipProperties.Text="Asignar a usuario"
                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=IsAdmin}"/>

                            <!-- Botón Editar -->
                            <ImageButton Grid.Column="3" Source="edit_icon.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent"
                                         Clicked="OnEditClicked" CommandParameter="{Binding .}" ToolTipProperties.Text="Editar"/>
                            
                            <!-- Botón Eliminar -->
                            <ImageButton Grid.Column="4" Source="delete_icon3.png" WidthRequest="25" HeightRequest="25" BackgroundColor="Transparent"
                                         Clicked="OnDeleteClicked" CommandParameter="{Binding .}" ToolTipProperties.Text="Eliminar"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ========== PANEL POPUP: Asignar Encuesta ========== -->
        <Grid x:Name="AssignPopupOverlay" IsVisible="False">
            <!-- Fondo oscuro (cierra el popup al tocar) -->
            <BoxView BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Panel central -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="16" Padding="20" Margin="20"
                   VerticalOptions="Center" HorizontalOptions="Fill"
                   MaximumHeightRequest="500">
                <VerticalStackLayout Spacing="12">

                    <!-- Encabezado -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Asignar Encuesta" FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <Label x:Name="PopupFormTitleLabel" FontSize="13"
                                   TextColor="{AppThemeBinding Light=DimGray, Dark=LightGray}"/>
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="1" Source="cerrar.png" WidthRequest="24" HeightRequest="24"
                                     BackgroundColor="Transparent" Clicked="OnClosePopupClicked"
                                     VerticalOptions="Start"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=LightGray, Dark=#444444}"/>

                    <Label Text="Selecciona el usuario:" FontSize="14"
                           TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"/>

                    <!-- Lista de usuarios -->
                    <CollectionView x:Name="PopupUsersList" SelectionMode="Single" HeightRequest="280"
                                    SelectionChanged="OnUserSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnDefinitions="Auto,*">
                                    <Frame Grid.ColumnSpan="2" BackgroundColor="Transparent"
                                           BorderColor="Transparent" Padding="0"/>
                                    <BoxView Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                             CornerRadius="20" BackgroundColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}"
                                             VerticalOptions="Center"/>
                                    <Label Grid.Column="0" Text="{Binding UserName[0]}"
                                           TextColor="White" FontAttributes="Bold" FontSize="16"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                        <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="15"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label FontSize="13" TextColor="{AppThemeBinding Light=DimGray, Dark=LightGray}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="FirstName"/>
                                                    <Binding Path="LastName"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ActivityIndicator x:Name="PopupLoadingIndicator" IsRunning="False" IsVisible="False"
                                       Color="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" HorizontalOptions="Center"/>

                    <Button x:Name="ConfirmAssignButton" Text="Confirmar Asignación"
                            BackgroundColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" TextColor="White"
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48"
                            Clicked="OnConfirmAssignClicked" IsEnabled="False"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <Button Text="+" FontSize="30" FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" TextColor="White"
                CornerRadius="30" WidthRequest="60" HeightRequest="60"
                HorizontalOptions="End" VerticalOptions="End" Margin="20"
                Clicked="OnCreateNewClicked"
                IsVisible="{Binding IsAdmin}"/>
    </Grid>
</ContentPage>