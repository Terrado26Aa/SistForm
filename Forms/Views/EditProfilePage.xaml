<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.EditProfilePage"
             Title="Mi Perfil">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Image Source="username.png" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" Margin="0,20,0,20"/>
            
            <Label Text="Nombre" FontSize="14" TextColor="Gray" FontAttributes="Bold" Margin="0,0,0,-15"/>
            <Entry x:Name="FirstNameEntry" Placeholder="tu nombre" FontSize="16"/>

            <Label Text="Apellido" FontSize="14" TextColor="Gray" FontAttributes="Bold" Margin="0,0,0,-15"/>
            <Entry x:Name="LastNameEntry" Placeholder="tu apellido" FontSize="16"/>

            <Label Text="correo electronico" FontSize="14" TextColor="Gray" FontAttributes="Bold" Margin="0,0,0,-15"/>
            <Entry x:Name="EmailEntry" Placeholder="tu@correo.com" FontSize="16" Keyboard="Email"/>

            <Button Text="Guardar cambios" BackgroundColor="CornflowerBlue" TextColor="White" HeightRequest="50" CornerRadius="10"
                    Margin="0,30,0,0" Clicked="OnSaveProfileClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>