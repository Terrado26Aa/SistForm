<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="Forms.Views.ResultsDashboardPage"
             Title="Dashboard de Resultados">
    
    <Grid RowDefinitions="*, 300">
        <!-- Mapa GIS -->
        <maps:Map x:Name="ResultsMap" Grid.Row="0" IsShowingUser="True" MapType="Street"/>

        <!-- Lista de Respuestas -->
        <VerticalStackLayout Grid.Row="1" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}" Padding="10">
            <Label x:Name="FormTitleLabel" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            
            <CollectionView x:Name="ResultsList" SelectionMode="Single" SelectionChanged="OnResultSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5" Padding="10" BorderColor="Gray" CornerRadius="5"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding SaveAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="14" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    <Label Text="{Binding UserId, StringFormat='Usuario ID: {0}'}" FontSize="12"
                                           TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ver en mapa" TextColor="SkyBlue" VerticalOptions="Center" FontSize="12"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <ActivityIndicator x:Name="LoadingIndicator" Grid.RowSpan="2" IsRunning="False" IsVisible="False" Color="SkyBlue" 
                           VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
