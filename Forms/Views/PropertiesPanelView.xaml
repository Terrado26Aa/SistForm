<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.PropertiesPanelView">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Propiedades del Elemento" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>

        <Label Text="Alineación" FontAttributes="Bold"/>
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button Text="Izquierda" WidthRequest="100"/>
            <Button Text="Centro" WidthRequest="100"/>
            <Button Text="Derecha" WidthRequest="100"/>
        </HorizontalStackLayout>

        <Label Text="Fuente" FontAttributes="Bold"/>
        <Grid ColumnDefinitions="*,*, auto" ColumnSpacing="10">
            <Picker x:Name="FontFamilyPicker" Title="Fuente" SelectedIndexChanged="OnFontFamilyChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Arial</x:String>
                        <x:String>Times New Roman</x:String>
                        <x:String>Verdana</x:String> "
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Picker x:Name="FontStylePicker" Grid.Column="1" Title="Estilo">
                
            </Picker>
            <Picker x:Name="FontSizePicker" Grid.Column="2" Title="Tamaño" SelectedIndexChanged="OnFontSizeChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>12</x:String>
                        <x:String>14</x:String>
                        <x:String>16</x:String>
                        <x:String>18</x:String>
                        <x:String>20</x:String>
                        <x:String>24</x:String>
                        <x:String>28</x:String>
                        <x:String>32</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>
    </VerticalStackLayout>
</ContentView>
