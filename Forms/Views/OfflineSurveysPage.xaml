<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.OfflineSurveysPage"
             Title="Encuestas Offline">
    <Grid>
        <Label x:Name="EmptyMessageLabel"
               Text="No tienes encuestas descargadas."
               HorizontalOptions="Center" VerticalOptions="Center"
               HorizontalTextAlignment="Center" Margin="20" IsVisible="False" TextColor="Gray"/>

        <CollectionView x:Name="OfflineFormList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10,5" Padding="15" BorderColor="Gray" CornerRadius="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="{Binding Description}" FontSize="14" TextColor="DarkGray" Margin="0,5,0,0"/>

                            <Button Text="Llenar Encuesta" Margin="0,10,0,0" BackgroundColor="CornflowerBlue"
                                    Clicked="OnFillOfflineSurveyClicked" CommandParameter="{Binding .}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>