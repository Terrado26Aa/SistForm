<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.CreateForm"
             Title="Nueva Encuesta"
             BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#121212}">
    <Grid RowDefinitions="auto, *, auto">
        <CollectionView Grid.Row="0" x:Name="ToolbarCollection" HeightRequest="70" BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#1E1E1E}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10,5" Margin="5" HasShadow="True" CornerRadius="8"
                           BorderColor="{AppThemeBinding Light=#512BD4, Dark=#ac99ea}" 
                           BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#333333}">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="{Binding IconImageSource}" HeightRequest="24" WidthRequest="24"/>
                            <Label Text="{Binding Text}" FontSize="14" TextColor="White" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Command}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">
                <Frame HasShadow="True" 
                       BorderColor="{AppThemeBinding Light=LightGray, Dark=#333333}" 
                       CornerRadius="10" 
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                       Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Entry x:Name="FormTitleEntry"
                               Placeholder="Titulo del formulario"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               PlaceholderColor="{AppThemeBinding Light=Gray, Dark=LightGray}"/>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=LightGray, Dark=#444444}"/>

                        <Editor x:Name="FormDescriptionEditor"
                                Placeholder="Descripción del formulario"
                                FontSize="16"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                PlaceholderColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame HasShadow="True"
                       BorderColor="{AppThemeBinding Light=LightGray, Dark=#333333}"
                       CornerRadius="5"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                       MinimumHeightRequest="400">
                    <Grid x:Name="CanvasGrid" RowSpacing="10" Padding="15">
                        
                    </Grid>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="Guardar Formulario" Margin="20" Clicked="OnSaveFormClicked"/>
    </Grid>
</ContentPage>