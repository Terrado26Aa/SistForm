<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.Login"
             Title="Login">

    <ScrollView>
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" RowDefinitions="150, *">

            <StackLayout Grid.Row="0">
                <Grid Padding="0">
                    <Image Source="fondo2.jpg" Aspect="AspectFill"/>
                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.3"/>
                                <GradientStop Color="{AppThemeBinding Light=White, Dark=#1f1f1f}" Offset="1"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <Border StrokeShape="RoundRectangle 100,100,100,100"
                            WidthRequest="200" HeightRequest="200"
                            StrokeThickness="0"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#4A4A4A}" Offset="0"/>
                                <GradientStop Color="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="forms.png" Aspect="AspectFit" HeightRequest="180" WidthRequest="180"/>
                    </Border>
                </Grid>
            </StackLayout>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" StrokeShape="RoundRectangle 40, 40, 0,0" Grid.Row="1" Padding="20,0">
                <VerticalStackLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                    <Grid RowDefinitions="Auto, *, *, *">
                        <StackLayout Grid.Row="0">
                            <Label Text="Bienvenido" HorizontalOptions="Center" FontSize="Title" FontAttributes="Bold" Padding="0,20,0,0"
                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                            <Label Text="Inicia sesion para continuar" HorizontalOptions="Center" FontSize="Subtitle" Padding="0,0,0,20"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                        </StackLayout>

                        <!--ingresa el usuario-->
                        <StackLayout Grid.Row="1" Orientation="Vertical" HorizontalOptions="FillAndExpand">
                            <Frame BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=LightBlue, Dark=DeepSkyBlue}" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                                <StackLayout Orientation="Horizontal">
                                    <Frame BackgroundColor="Transparent" HeightRequest="40" WidthRequest="40" CornerRadius="30" Padding="0" Margin="5">
                                        <Frame.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{AppThemeBinding Light=#E8F4FF, Dark=#3A3A3A}" Offset="0"/>
                                                <GradientStop Color="{AppThemeBinding Light=#D0E8FF, Dark=#2A2A2A}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Frame.Background>
                                        <Image Source="username.png" Aspect="AspectFill" Margin="0"/>
                                    </Frame>
                                    <Entry x:Name="UsernameEntry" Text="{Binding Username}" Placeholder="Usuario" 
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                           BackgroundColor="Transparent"
                                           FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                                </StackLayout>
                            </Frame>

                            <Frame BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=LightBlue, Dark=DeepSkyBlue}" Margin="0,15,0,0" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                                <StackLayout Orientation="Horizontal">
                                    <Frame BackgroundColor="Transparent" HeightRequest="40" WidthRequest="40" CornerRadius="30" Padding="0" Margin="5">
                                        <Frame.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{AppThemeBinding Light=#E8F4FF, Dark=#3A3A3A}" Offset="0"/>
                                                <GradientStop Color="{AppThemeBinding Light=#D0E8FF, Dark=#2A2A2A}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Frame.Background>
                                        <Image Source="password.png" Aspect="AspectFill" Margin="0"/>
                                    </Frame>
                                    <Entry x:Name="PasswordEntry" Text="{Binding Password}" Placeholder="Contraseña" IsPassword="True" 
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                           BackgroundColor="Transparent"
                                           FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                                </StackLayout>
                            </Frame>

                            <StackLayout Orientation="Horizontal" Margin="0,10,0,0" Padding="0">
                                <CheckBox IsChecked="False" Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"/>
                                <Label Text="Recordarme" TextColor="{AppThemeBinding Light=DarkGray, Dark=LightGray}" FontSize="Small" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                                <Label Text="Olvide la Contraseña" TextColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" FontAttributes="Bold" HorizontalOptions="EndAndExpand" VerticalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                            </StackLayout>

                            <Button Text="Iniciar Sesion" BackgroundColor="{AppThemeBinding Light=#0cf4f4, Dark=#0aa0a0}" TextColor="White" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,15,0,0"
                            Command="{Binding LoginCommand}"/>
                            
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" />
                            
                            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light=Red, Dark=#FF6B6B}" IsVisible="{Binding IsErrorVisible}"/>

                            <Button Text="Modo Offline" BackgroundColor="{AppThemeBinding Light=DarkGray, Dark=Gray}" TextColor="white" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,15,0,0"
                            Command="{Binding GoToOfflineModeCommand}"/>
                        </StackLayout>

                        <StackLayout Grid.Row="2" Orientation="Horizontal" HorizontalOptions="CenterAndExpand" Margin="0,30,0,0" Padding="0">
                            <Label Text="¿No tienes una cuenta?" TextColor="{AppThemeBinding Light=DarkGray, Dark=LightGray}" FontSize="Small" VerticalOptions="Center"/>
                            <Button Text="Registrate" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=SkyBlue, Dark=DeepSkyBlue}" FontAttributes="Bold" FontSize="Medium"
                            Command="{Binding GoToRegisterCommand}"/>
                        </StackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>