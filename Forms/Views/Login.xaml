<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Forms.Views.Login"
             Title="Login">

    <ScrollView>
        <Grid BackgroundColor="White" RowDefinitions="150, *">

            <StackLayout Grid.Row="0">
                <Grid Padding="0">
                    <Image Source="fondo2.jpg" Aspect="AspectFill"/>
                    <Image Source="forms.png" Aspect="AspectFit" HeightRequest="200" WidthRequest="200"/>
                </Grid>
            </StackLayout>

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 40, 40, 0,0" Grid.Row="1" Padding="20,0">
                <VerticalStackLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                    <Grid RowDefinitions="Auto, *, *, *">
                        <StackLayout Grid.Row="0">
                            <Label Text="Bienvenido" HorizontalOptions="Center" FontSize="Title" FontAttributes="Bold" Padding="0,20,0,0"/>
                            <Label Text="Inicia sesion para continuar" HorizontalOptions="Center" FontSize="Subtitle" Padding="0,0,0,20"/>
                        </StackLayout>

                        <!--ingresa el usuario-->
                        <StackLayout Grid.Row="1" Orientation="Vertical" HorizontalOptions="FillAndExpand">
                            <Frame BackgroundColor="Transparent" BorderColor="LightBlue" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                                <StackLayout Orientation="Horizontal">
                                    <Frame BackgroundColor="Transparent" HeightRequest="40" WidthRequest="40" CornerRadius="30" Padding="0" Margin="5">
                                        <Image Source="username.png" Aspect="AspectFill" Margin="0"/>
                                    </Frame>
                                    <Entry x:Name="UsernameEntry" Text="{Binding Username}" Placeholder="Usuario" TextColor="Black"
                                   FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                                </StackLayout>
                            </Frame>

                            <!--ingresa la contraseña-->
                            <Frame BackgroundColor="Transparent" BorderColor="LightBlue" Margin="0,15,0,0" Padding="0" HorizontalOptions="FillAndExpand" CornerRadius="30">
                                <StackLayout Orientation="Horizontal">
                                    <Frame BackgroundColor="Transparent" HeightRequest="40" WidthRequest="40" CornerRadius="30" Padding="0" Margin="5">
                                        <Image Source="password.png" Aspect="AspectFill" Margin="0"/>
                                    </Frame>
                                    <Entry x:Name="PasswordEntry" Text="{Binding Password}" Placeholder="Contraseña" IsPassword="True" TextColor="Black"
                                   FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Margin="0,0,20,0"/>
                                </StackLayout>
                            </Frame>

                            <StackLayout Orientation="Horizontal" Margin="0,10,0,0" Padding="0">
                                <CheckBox IsChecked="False"/>
                                <Label Text="Recordarme" TextColor="DarkGray" FontSize="Small" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                                <Label Text="Olvide la Contraseña" TextColor="SkyBlue" FontAttributes="Bold" HorizontalOptions="EndAndExpand" VerticalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                            </StackLayout>

                            <!--Boton para iniciar sesion-->
                            <Button Text="Iniciar Sesion" Background="#0cf4f4" TextColor="White" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0,15,0,0"
                            Clicked="OnLoginClicked"/>
                            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False"/>
                        </StackLayout>

                        <!--Boton para registrarse-->
                        <StackLayout Grid.Row="2" Orientation="Horizontal" HorizontalOptions="CenterAndExpand" Margin="0,30,0,0" Padding="0">
                            <Label Text="¿No tienes una cuenta?" TextColor="DarkGray" FontSize="Small" VerticalOptions="Center"/>
                            <Button Text="Registrate" BackgroundColor="Transparent" TextColor="SkyBlue" FontAttributes="Bold" FontSize="Medium"
                            Clicked="OnSigninClicked"/>
                        </StackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>